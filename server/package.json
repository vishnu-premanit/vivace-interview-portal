{
  "name": "vivace-server",
  "version": "1.0.0",
  "private": true,
  "description": "Vivace API — Express gateway that also serves the Angular build",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
