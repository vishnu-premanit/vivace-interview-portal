# Copy to .env (repo root) for local runs. On Render, set these in the dashboard.

# MongoDB Atlas connection string. Leave empty locally to use an in-memory MongoDB (data resets on restart).
MONGODB_URI=

# At least 32 random characters in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=2d

# Optional — Google Gemini. Without a key Vivace runs on its offline engines.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — Python ML service (FastAPI). Without it the Node engines are used.
ML_SERVICE_URL=

PORT=8080
NODE_ENV=development
MAX_UPLOAD_MB=40
# Only needed if the Angular app is served from a different origin than the API.
CORS_ORIGIN=
