{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/server.js",
      "cwd": "${workspaceFolder}/server",
      "env": { "NODE_ENV": "development" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Open app in Chrome (localhost:8080)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/client/src"
    },
    {
      "name": "Open dev app in Chrome (localhost:4200)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/client/src"
    },
    {
      "name": "Debug current Jest test file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "${relativeFile}"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    { "name": "API + Chrome", "configurations": ["Debug API server", "Open app in Chrome (localhost:8080)"] }
  ]
}
